{
  "name": "app-x-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/local/start-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/local/stop-local.ps1",
    "local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/local/status-local.ps1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:journeys": "playwright test tests/e2e/role-journeys.spec.ts",
    "test:visual-baseline": "playwright test tests/e2e/visual-baseline.spec.ts",
    "test:visual-release": "playwright test tests/e2e/release-visual.spec.ts",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "test:watch": "vitest",
    "test:rls": "supabase test db",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:performance"
  },
  "dependencies": {
    "@netlify/functions": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.4",
    "nodemailer": "9.1.1",
    "openai": "7.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
