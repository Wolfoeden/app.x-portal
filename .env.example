# Public browser configuration. The publishable key is safe to expose; RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=12000
# Keep these aligned with the selected provider/model price sheet.
OPENAI_INPUT_USD_PER_MILLION=0.20
OPENAI_OUTPUT_USD_PER_MILLION=1.20
OPENAI_COST_MULTIPLIER=1.00
IP_HASH_SECRET=

# Provider and product configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Set to /chat for the production build served below x-portal.eu/chat.
NEXT_PUBLIC_APP_BASE_PATH=
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/romandering/30min
NEXT_PUBLIC_CONTACT_PHONE=+491758934338

# Usage controls. Values are conservative V1 defaults and can be changed without a deploy.
AI_REQUESTS_PER_MINUTE=6
AI_DAILY_TOKEN_LIMIT_GUEST=20000
AI_DAILY_TOKEN_LIMIT_USER=100000
AI_MONTHLY_PROVIDER_BUDGET_CENTS=5000

# Data lifecycle is configured in public.retention_policies through Supabase
# Studio. There are intentionally no duplicate environment-based retention
# values.
