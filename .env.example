# Public browser configuration. The publishable key is safe to expose; RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Optional: Fine-grained Token ohne Berechtigungen für den GitHub-Import im
# Bewerbungsformular. Ohne gilt das öffentliche Limit (60 Abrufe/Stunde).
GITHUB_TOKEN=
# Informational only: live server routes enforce this allowlisted snapshot.
OPENAI_BRIEF_MODEL=gpt-5.4-nano-2026-03-17
OPENAI_WEB_SEARCH_MODEL=gpt-5.4-nano-2026-03-17
OPENAI_TIMEOUT_MS=20000
# Keep OPENAI_BASE_URL unset to use the customer-owned key directly with the
# official OpenAI API. A platform AI gateway may inject its own base URL.
OPENAI_WEB_SEARCH_TIMEOUT_MS=30000
# Legacy conservative monthly-cap estimate only. Per-request reporting uses
# the versioned registry in lib/ai/model-pricing.ts, including cached input.
OPENAI_INPUT_USD_PER_MILLION=0.20
OPENAI_OUTPUT_USD_PER_MILLION=1.25
OPENAI_COST_MULTIPLIER=1.00
IP_HASH_SECRET=
# Leave false on Netlify (the runtime context supplies the trusted IP). Enable
# only behind a verified proxy that strips client-provided forwarding headers.
TRUST_PROXY_IP_HEADERS=false
# Comma-separated Supabase Auth UUIDs. Prefer an app_metadata admin role;
# this allowlist is an operational fallback and is never exposed client-side.
ADMIN_USER_IDS=

# Provider and product configuration.
# Local development only. Netlify production is fixed to https://x-portal.eu
# in netlify.toml; never scope this localhost value to production builds.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Leave empty when this app owns the /home and /chat routes on its domain.
# Set only when the whole Next.js app is mounted below a real base path.
NEXT_PUBLIC_APP_BASE_PATH=
# Provider buttons are shown only when the matching Supabase provider is ready.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_MICROSOFT_ENABLED=false
# Nur im Freelancer-Zugang (/freelancer/apply). Erst einschalten, wenn der
# Provider in Supabase (Auth → Providers) eingerichtet ist.
NEXT_PUBLIC_AUTH_LINKEDIN_ENABLED=false
NEXT_PUBLIC_AUTH_GITHUB_ENABLED=false
# Vermittlungsmodell (lib/placement/config.ts): Anfrage mit Zustimmung statt
# Direktlink in den Kalender. Erst einschalten, wenn die Vermittlungsbedingungen
# rechtlich geprüft sind. Wirkt erst nach einem neuen Build.
NEXT_PUBLIC_PLACEMENT_REQUESTS_ENABLED=false
# Google-Ads-Tag (components/GoogleAdsTag.tsx), lädt nur nach Zustimmung im
# Cookie-Banner. Leer lassen: Das Banner bleibt eine Kenntnisnahme. Produktion
# setzt die ID in netlify.toml.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Referenznotizen des Betreibers auf Profilkarten zeigen (lib/data/profile-extras.ts).
# Erst einschalten, wenn alle Notizen auf Kundennamen geprüft sind.
PROFILE_REFERENCES_VISIBLE=false
NEXT_PUBLIC_CALENDLY_URL=

# Provider safety controls. These do not define customer entitlements: the
# database separately enforces 10/100 successful Nano analyses per month.
AI_REQUESTS_PER_MINUTE=6
AI_WEB_SEARCH_REQUESTS_PER_MINUTE=2
AI_PROVIDER_DAILY_TOKEN_SAFETY_LIMIT_GUEST=500000
AI_PROVIDER_DAILY_TOKEN_SAFETY_LIMIT_USER=5000000
AI_PROVIDER_DAILY_TOKEN_SAFETY_LIMIT_ADMIN=10000000
AI_MONTHLY_PROVIDER_BUDGET_CENTS=5000
# Conservative preflight reservation when a requested model has no price entry.
AI_UNKNOWN_MODEL_ESTIMATED_COST_CENTS=100
# Free monthly Nano usage is fixed by the database policy: 10 successful
# analyses for guests and 100 for signed-in accounts. Purchased product credits
# are separate and are granted through the audited operator RPC in V1.

# Transactional email (IONOS SMTP). Without a complete set the application
# does not guess: delivery reports itself as unconfigured and the interface
# says so instead of promising a mail that never goes out.
# IONOS: smtp.ionos.de, port 587 (STARTTLS) or 465 (implicit TLS). The user is
# the full mailbox address; EMAIL_FROM must be that same mailbox or an alias
# the account owns, otherwise IONOS rejects the message.
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Signs the unsubscribe link in every promotional message. Without it no cold
# outreach and no newsletter goes out at all — a promotional mail whose opt-out
# link cannot be redeemed must not be sent, so delivery refuses it rather than
# shipping a broken promise. Transactional mail is unaffected.
# At least 32 characters; anything shorter counts as absent. Generate with
#   node -p "require('node:crypto').randomBytes(48).toString('base64url')"
# Rotating it invalidates every unsubscribe link in mail already delivered, so
# treat it as permanent. Entries already on the suppression list survive a
# rotation — they are stored by address hash, not by token.
EMAIL_UNSUBSCRIBE_SECRET=


# Where a contact-form submission is announced. Defaults to the imprint address.
# Set it when that mailbox is not the one actually being read: an enquiry that
# lands where nobody looks has not really arrived.
CONTACT_NOTIFICATION_EMAIL=

# „Gespräch buchen“ (/gespraech): the operator's own calendar, e.g. a Calendly
# event of 30 minutes with a first custom question „Gesuchte Rolle“. After the
# form, the visitor is sent there with name, email and role prefilled
# (?name=&email=&a1=). https only; empty means „we call you back“.
# The thank-you link is signed with EMAIL_UNSUBSCRIBE_SECRET.
SALES_CALL_URL=

# Booking destinations reachable without the confirmation interstitial.
# Comma-separated hostnames; subdomains are included. Empty falls back to
# calendly.com and cal.com.
BOOKING_ALLOWED_HOSTS=

# Enables /api/health?deep=1 for a monitor, sent as the x-health-token header.
# At least 16 characters; without it the deep check stays closed for everyone.
HEALTH_CHECK_TOKEN=

# Data lifecycle is configured in public.retention_policies through Supabase
# Studio. There are intentionally no duplicate environment-based retention
# values.

# hCaptcha für das öffentliche Kontaktformular.
# Der Sitekey ist öffentlich und steht im Browser; das Secret niemals.
# Fehlen beide, lässt die Prüfung in der Entwicklung durch und blockt in
# Produktion — ein vergessener Schlüssel soll den Schutz nicht still abschalten.
# Anlegen unter https://dashboard.hcaptcha.com
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# Stripe-Webhook: schaltet nach einer Zahlung die bezahlte Stufe frei.
# Das Signing Secret steht im Stripe-Dashboard unter Developers → Webhooks →
# dem Endpunkt → "Signing secret" und beginnt mit whsec_.
# Ohne diesen Wert weist die Route jeden Aufruf ab — ein vergessener Schlüssel
# darf keinen offenen Endpunkt hinterlassen.
STRIPE_WEBHOOK_SECRET=

# Rechnungen über das Vermittlungshonorar (lib/placement/invoices.ts).
# Eingeschränkter Schlüssel (rk_live_…) mit Schreibrecht auf Customers,
# Invoices, Invoice Items und Tax Rates genügt.
# Der Steuersatz ist optional: Ohne ID nimmt die Rechnung den aktiven,
# exklusiven 19-%-Satz für Deutschland aus dem Konto und legt ihn beim
# ersten Mal an. Mit ID (txr_…) gilt genau dieser, und er muss passen.
# Im Stripe-Webhook zusätzlich das Ereignis invoice.paid abonnieren
# (ist es für Abos schon, reicht das).
STRIPE_SECRET_KEY=
STRIPE_PLACEMENT_TAX_RATE_ID=

# Feste Monatsabonnements. URL, Payment-Link-ID und wiederkehrende Price-ID
# muessen jeweils zum selben Tarif gehoeren. Der Checkout verknuepft nur das
# Abo; Credits werden erst nach invoice.paid gesetzt und bei Fehlzahlung nicht
# erneuert. Die verifizierten Produktions-IDs sind zusätzlich im Code allowgelistet.
NEXT_PUBLIC_STRIPE_BASIC_PAYMENT_LINK=https://buy.stripe.com/7sY3cu24xa5z7ey64Ya3u04
STRIPE_BASIC_PAYMENT_LINK_ID=plink_1UG3v2CQxgmYRfmL4ktH8PYg
STRIPE_BASIC_PRICE_ID=price_1UGQfrCQxgmYRfmL7z6DURBe
NEXT_PUBLIC_STRIPE_PRO_PAYMENT_LINK=https://buy.stripe.com/3cIcN4fVnb9DcyS9haa3u05
STRIPE_PRO_PAYMENT_LINK_ID=plink_1UG3wWCQxgmYRfmLPI05Uc7q
STRIPE_PRO_PRICE_ID=price_1UGQgTCQxgmYRfmLkAttXxUC
NEXT_PUBLIC_STRIPE_BUSINESS_PAYMENT_LINK=https://buy.stripe.com/9B614m38Bb9DbuO2SMa3u02
STRIPE_BUSINESS_PAYMENT_LINK_ID=plink_1UBAWJCQxgmYRfmLtce10O55
STRIPE_BUSINESS_PRICE_ID=price_1UBAVPCQxgmYRfmLM6WX4Dax
# Aktivierter Stripe-Kundenportal-Link fuer Belege, Zahlungsmittel und
# Kuendigung. Keine geheime Information; muss mit /p/login/ beginnen.
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/9B6eVcgZr1z36au0KEa3u00

# Geheimnis fuer den taeglichen Lead-Abgleich (POST /api/leadgen/run).
# Derselbe Wert liegt im Supabase-Vault als leadgen_run_token; pg_cron
# schickt ihn im Kopf x-leadgen-run-token mit. Mindestens 32 Zeichen, sonst
# wird der Kopf ignoriert und nur eine Admin-Sitzung kommt durch.
LEADGEN_RUN_SECRET=

# Recruiting SaaS trial: server-created Subscription Checkout, 14 days and
# 90 credits from lib/billing/plans.ts. Historic Payment Links above are for
# existing contracts. Set test Price IDs and a TEST secret in isolated staging.
# Actual portal configuration must allow payment updates, invoices and
# cancellation at period end. SaaS legal draft currently blocks live Checkout.
STRIPE_RECRUITING_PORTAL_CONFIGURATION_ID=

# Optional product measurement uses renewed v3 consent. No advertising ID is
# required for this purpose; project/CV/contact text is never a parameter.
NEXT_PUBLIC_PRODUCT_ANALYTICS_ENABLED=false
