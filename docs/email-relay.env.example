# Netlify Functions: add both values, then deploy the endpoint.
# Cloud runner: add the SAME token securely; no SMTP connection is needed there.
# Separate random value with 32–256 characters. Never reuse another credential.
EMAIL_RELAY_TOKEN=

# Netlify Functions only. Comma-separated complete addresses; fails closed if empty.
EMAIL_RELAY_ALLOWED_RECIPIENTS=roman@dering.info

# Cloud runner only. Optional: this is the default trusted production endpoint.
EMAIL_RELAY_URL=https://x-portal.eu/api/email/send
